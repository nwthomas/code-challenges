{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "strict": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "vitest.config.ts"],
    "exclude": [
        "src/daily-coding-problem/easy/clockwise-spiral",
        "src/daily-coding-problem/easy/create-combinations",
        "src/daily-coding-problem/medium/longest-consecutive-elements",
        "src/daily-coding-problem/medium/remove-letters-for-palindrome",
        "src/daily-coding-problem/medium/next-bigger-element-node",
        "src/daily-coding-problem/easy/rearrange-string",
        "src/daily-coding-problem/hard/string-to-mathematical-equation",
        "src/daily-coding-problem/easy/find-all-char-variations-in-order",
        "src/miscellaneous-code-challenges/largest-sub-matrix",
        "src/daily-coding-problem/easy/find-strobogrammatic-numbers",
        "src/leetcode/easy/design-linked-list",
        "node_modules"
    ]
}
